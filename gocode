#!/usr/bin/env bash
# =============================================================================
# gocode v1.0.3 — Developer Workflow System
# UI: @clack/prompts (Node.js)   Logic: bash
# =============================================================================
set -euo pipefail
trap 'spinner_stop 2>/dev/null; tput cnorm 2>/dev/null' EXIT

GOCODE_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LIB="$GOCODE_DIR/lib"

source "$LIB/ui.sh"
source "$LIB/deps.sh"
source "$LIB/config.sh"
source "$LIB/registry.sh"
source "$LIB/git.sh"
source "$LIB/browser.sh"
source "$LIB/netlify.sh"
source "$LIB/obsidian.sh"
source "$LIB/colors.sh"
source "$LIB/readme_gen.sh"

load_config
init_registry
export TERM_COLS

# =============================================================================
# CLACK HELPER — runs prompt.js, result goes to tempfile
# Usage: clack_run <command> [json-arg]
# Result available in $CLACK_RESULT as parsed JSON
# =============================================================================

clack_run() {
    local cmd="$1"
    local arg="${2:-}"
    local tmpfile; tmpfile=$(mktemp)

    GOCODE_RESULT_FILE="$tmpfile" TERM_COLS="$TERM_COLS" node "$LIB/prompt.js" "$cmd" "$arg"
    local exit_code=$?

    if [ $exit_code -ne 0 ]; then
        rm -f "$tmpfile"
        exit 1
    fi

    CLACK_RESULT=$(cat "$tmpfile")
    rm -f "$tmpfile"
}

clack_log() { node "$LIB/prompt.js" "$1" "${@:2}" 2>/dev/null || true; }

# =============================================================================
# HELPERS
# =============================================================================

_all_active_projects_json() {
    jq -c '[.projects[] | select(.status=="active") | .name]' \
        "$PROJECTS_REGISTRY" 2>/dev/null || echo '[]'
}

_all_projects_json() {
    jq -c '[.projects[].name]' "$PROJECTS_REGISTRY" 2>/dev/null || echo '[]'
}

# =============================================================================
# CREATE PROJECT
# =============================================================================

create_project() {
    check_dependencies

    # All prompts via @clack
    clack_run "create"

    local name description type create_github visibility deploy_netlify
    name=$(echo          "$CLACK_RESULT" | jq -r '.name')
    description=$(echo   "$CLACK_RESULT" | jq -r '.description')
    type=$(echo          "$CLACK_RESULT" | jq -r '.type')
    create_github=$(echo "$CLACK_RESULT" | jq -r '.create_github')
    visibility=$(echo    "$CLACK_RESULT" | jq -r '.visibility')
    deploy_netlify=$(echo "$CLACK_RESULT" | jq -r '.deploy_netlify')

    if project_exists "$name"; then
        clack_log error "'${name}' already exists."; exit 1
    fi

    # Scaffold
    local project_path="$PROJECTS_DIR/$name"
    mkdir -p "$project_path"
    clack_log ok "Created: ${project_path}"

    _inject_boilerplate "$type" "$project_path"

    if command -v python3 &>/dev/null; then
        generate_palette
        inject_palette "$project_path/style.css"
    fi

    cd "$project_path"
    git_init_and_commit

    # Background: search similar repos
    github_search_similar "$name" &

    # GitHub
    local repo_url="local-only"
    [ "$create_github" = "true" ] && repo_url=$(github_create_repo "$name" "$visibility")

    # Netlify
    local netlify_url="not-deployed"
    [ "$deploy_netlify" = "true" ] && \
        netlify_url=$(netlify_deploy "$name" "$project_path" "$repo_url")

    # README
    generate_project_readme "$name" "$type" "$project_path" \
        "$repo_url" "$netlify_url" "$description"

    git_push_final "$repo_url"

    # Registry
    add_project_to_registry "$name" "$project_path" "$type" \
        "$repo_url" "$netlify_url" "$description"

    # Obsidian
    {
        obsidian_project_note "$name" "$type" "$repo_url" "$netlify_url" "$description"
        obsidian_daily_log "Created: ${name}"
    } &

    # Summary

    # Open tools
    code "$project_path" &>/dev/null &
    { [ "$netlify_url" != "not-deployed" ] && browser_open_tabs "$netlify_url" || browser_open_tabs ""; } &

    # Final @clack summary
    node "$LIB/prompt.js" outro-create \
        "$name" "$type" "$project_path" "$repo_url" "$netlify_url"
}

_inject_boilerplate() {
    local type="$1" dest="$2"
    local src="$GOCODE_DIR/boilerplates/${type}"

    if [ "$type" = "react" ]; then
        spinner_start "Scaffolding React + Vite..."
        bash "$src/scaffold.sh" "$dest" 2>/dev/null
        spinner_stop
        clack_log ok "React + Vite scaffolded."
        return
    fi

    if [ "$type" = "tailwind" ]; then
        spinner_start "Scaffolding Tailwind CSS CLI..."
        bash "$src/scaffold.sh" "$dest" 2>/dev/null
        spinner_stop
        clack_log ok "Tailwind CSS CLI scaffolded."
        return
    fi

    if [ -d "$src" ]; then
        cp -r "$src/." "$dest/"
        clack_log ok "Boilerplate injected (${type})."
    fi
}

# =============================================================================
# RESUME
# =============================================================================

resume_project() {
    check_dependencies
    local active_json; active_json=$(_all_active_projects_json)

    if [ "$active_json" = "[]" ]; then
        clack_log info "No active projects. Create one: gocode --new"
        exit 0
    fi

    clack_run "resume" "$active_json"

    local chosen; chosen=$(echo "$CLACK_RESULT" | jq -r '.name')
    local path; path=$(get_project_field "$chosen" "path")

    if [ -d "$path/.git" ]; then
        local dirty; dirty=$(cd "$path" && git status --short 2>/dev/null | wc -l)
        [ "$dirty" -gt 0 ] && clack_log warn "${dirty} uncommitted change(s) in ${chosen}"
    fi

    update_last_opened "$chosen"
    obsidian_daily_log "Resumed: ${chosen}" &
    code "$path" &>/dev/null &
    clack_log ok "Opened: ${chosen}"
}

# =============================================================================
# PUSH
# =============================================================================

cmd_push() {
    local name; name=$(jq -r '[.projects[] | select(.status=="active") | .name] | .[0]' \
        "$PROJECTS_REGISTRY" 2>/dev/null)

    clack_run "push" "${name:-}"

    local commit_type commit_msg
    commit_type=$(echo "$CLACK_RESULT" | jq -r '.type')
    commit_msg=$(echo  "$CLACK_RESULT" | jq -r '.message')

    local path; path=$(get_project_field "${name:-}" "path")
    cd "${path:-.}"

    if git diff --quiet && git diff --cached --quiet; then
        clack_log warn "Nothing to commit."; return
    fi

    git add .
    git commit -m "${commit_type}: ${commit_msg}" -q
    spinner_start "Pushing..."
    git push -q 2>/dev/null
    spinner_stop
    clack_log ok "Pushed: ${commit_type}: ${commit_msg}"
}

# =============================================================================
# DELETE
# =============================================================================

cmd_delete() {
    local active_json; active_json=$(_all_projects_json)
    clack_run "delete" "$active_json"

    local name delete_github
    name=$(echo          "$CLACK_RESULT" | jq -r '.name')
    delete_github=$(echo "$CLACK_RESULT" | jq -r '.delete_github')

    local path; path=$(get_project_field "$name" "path")
    local repo; repo=$(get_project_field "$name" "repo_url")

    # Delete folder
    if [ -d "$path" ]; then
        rm -rf "$path"
        clack_log ok "Folder deleted."
    else
        clack_log warn "Folder not found: ${path}"
    fi

    # Delete GitHub repo
    if [ "$delete_github" = "true" ] && [ "$repo" != "local-only" ]; then
        spinner_start "Deleting GitHub repo..."
        gh repo delete "${GH_USER}/${name}" --yes 2>/dev/null \
            && { spinner_stop; clack_log ok "GitHub repo deleted."; } \
            || { spinner_stop; clack_log warn "GitHub delete failed — remove manually."; }
    fi

    # Remove from registry
    local updated
    updated=$(jq --arg n "$name" 'del(.projects[] | select(.name==$n))' \
        "$PROJECTS_REGISTRY")
    _registry_write "$updated"
    clack_log ok "Removed from registry."

    # Remove Obsidian note
    local note="${OBSIDIAN_VAULT:-}/gocode-projects/${name}.md"
    [ -f "$note" ] && rm "$note" && clack_log ok "Obsidian note removed."

    clack_log outro "Deleted: ${name}"
}

# =============================================================================
# EDIT
# =============================================================================

cmd_edit() {
    local active_json; active_json=$(_all_projects_json)
    clack_run "edit" "$active_json"

    local name field value
    name=$(echo  "$CLACK_RESULT" | jq -r '.name')
    field=$(echo "$CLACK_RESULT" | jq -r '.field')
    value=$(echo "$CLACK_RESULT" | jq -r '.value')

    case "$field" in
        name)
            local old_path; old_path=$(get_project_field "$name" "path")
            local new_path; new_path="$(dirname "$old_path")/${value}"
            mv "$old_path" "$new_path"; clack_log ok "Folder renamed."

            local old_repo; old_repo=$(get_project_field "$name" "repo_url")
            local new_repo="local-only"
            [ "$old_repo" != "local-only" ] && new_repo=$(github_rename_repo "$name" "$value")

            local old_note="${OBSIDIAN_VAULT:-}/gocode-projects/${name}.md"
            local new_note="${OBSIDIAN_VAULT:-}/gocode-projects/${value}.md"
            [ -f "$old_note" ] && mv "$old_note" "$new_note" && clack_log ok "Obsidian note renamed."

            update_project_field "$name"  "name"     "$value"
            update_project_field "$value" "path"     "$new_path"
            [ "$new_repo" != "local-only" ] && update_project_field "$value" "repo_url" "$new_repo"

            clack_log outro "Renamed: ${name} → ${value}"
            ;;

        description)
            update_project_field "$name" "description" "$value"

            local repo; repo=$(get_project_field "$name" "repo_url")
            [ "$repo" != "local-only" ] && github_set_description "$name" "$value"

            local path; path=$(get_project_field "$name" "path")
            [ -f "$path/README.md" ] && \
                sed -i "s|^_Add a short description.*|${value}|" "$path/README.md" 2>/dev/null || true

            local note="${OBSIDIAN_VAULT:-}/gocode-projects/${name}.md"
            [ -f "$note" ] && \
                sed -i "s|^\*\*Description:\*\*.*|**Description:** ${value}|" "$note" 2>/dev/null || true

            clack_log outro "Description updated everywhere."
            ;;

        visibility)
            github_set_visibility "$name" "$value"
            update_project_field "$name" "visibility" "$value"
            clack_log outro "Visibility set to: ${value}"
            ;;
    esac
}

# =============================================================================
# STATUS
# =============================================================================

cmd_status() {
    print_banner
    local projects=()
    mapfile -t projects < <(get_incomplete_projects)
    [ ${#projects[@]} -eq 0 ] && log_error "No active projects." && exit 1
    local name
    [ ${#projects[@]} -eq 1 ] && name="${projects[0]}" || \
        name=$(printf '%s\n' "${projects[@]}" | \
            fzf --prompt="  Status for: " --height=10 --border=rounded --no-info 2>/dev/tty)

    local path;    path=$(get_project_field    "$name" "path")
    local repo;    repo=$(get_project_field    "$name" "repo_url")
    local netlify; netlify=$(get_project_field "$name" "netlify_url")
    local type;    type=$(get_project_field    "$name" "type")
    local created; created=$(get_project_field "$name" "created")
    local desc;    desc=$(get_project_field    "$name" "description")

    divider
    log_info "Project:  ${BOLD}${name}${RESET}"
    log_info "Type:     ${type}"
    log_info "Desc:     ${desc}"
    log_info "Path:     ${path}"
    log_info "Created:  ${created}"
    [ "$repo" != "local-only" ]      && log_info "GitHub:   ${repo}"
    [ "$netlify" != "not-deployed" ] && log_info "Live:     ${netlify}"
    if [ -d "$path/.git" ]; then
        local branch dirty
        branch=$(cd "$path" && git branch --show-current 2>/dev/null || echo "?")
        dirty=$(cd "$path" && git status --short 2>/dev/null | wc -l)
        log_info "Branch:   ${branch}  |  Uncommitted: ${dirty}"
    fi
    divider
}

# =============================================================================
# LIST
# =============================================================================

cmd_list() {
    print_banner
    local rows
    rows=$(jq -r '.projects[] | "\(.status)\t\(.name)\t\(.type)\t\(.created)"' \
        "$PROJECTS_REGISTRY" 2>/dev/null)

    [ -z "$rows" ] && log_info "No projects yet. Run: gocode --new" && return

    echo ""
    echo -e "  ${BOLD}${CYAN}STATUS     NAME                     TYPE       CREATED${RESET}"
    divider
    while IFS=$'\t' read -r status pname ptype pcreated; do
        local icon col
        case "$status" in
            active)    icon="●" col="$GREEN"  ;;
            completed) icon="✓" col="$CYAN"   ;;
            archived)  icon="○" col="$DIM"    ;;
            *)         icon="?" col="$YELLOW" ;;
        esac
        printf "  %b%s%b  %-24s %-10s %s\n" \
            "$col" "$icon" "$RESET" "$pname" "$ptype" "$pcreated"
    done <<< "$rows"
    divider
    echo ""
}

# =============================================================================
# LOG / DIFF / DEPLOY / COMPLETE / ARCHIVE / OPEN / STATS / BACKUP / DOCTOR
# =============================================================================

_pick_fzf() {
    local prompt="$1"; shift
    printf '%s\n' "$@" | \
        fzf --prompt="  ${prompt} " --height=12 --border=rounded --no-info 2>/dev/tty
}

_pick_active() {
    local prompt="$1"
    local projects=()
    mapfile -t projects < <(get_incomplete_projects)
    [ ${#projects[@]} -eq 0 ] && log_error "No active projects." && exit 1
    [ ${#projects[@]} -eq 1 ] && echo "${projects[0]}" && return
    _pick_fzf "$prompt" "${projects[@]}"
}

cmd_log() {
    local name; name=$(_pick_active "Show log for:")
    local path; path=$(get_project_field "$name" "path")
    echo ""; log_info "Last 10 commits — ${BOLD}${name}${RESET}:"
    cd "$path" && git log --oneline -10 --color=always; echo ""
}

cmd_diff() {
    local name; name=$(_pick_active "Show diff for:")
    local path; path=$(get_project_field "$name" "path")
    echo ""; cd "$path" && git diff --stat; echo ""
}

cmd_deploy() {
    local name; name=$(_pick_active "Deploy:")
    local path; path=$(get_project_field "$name" "path")
    local url;  url=$(netlify_deploy "$name" "$path")
    [ "$url" != "not-deployed" ] && update_project_field "$name" "netlify_url" "$url"
}

cmd_rename() {
    local name; name=$(_pick_active "Rename:")
    clack_run "edit" "[\"${name}\"]"
    # reuse edit flow but skip selection, pre-fill name field
    # simplest: just call edit with name pre-selected
    CLACK_RESULT="{\"name\":\"${name}\",\"field\":\"name\",\"value\":\"\"}"
    local new_name; new_name=$(node "$LIB/prompt.js" rename "$name" 2>/dev/null || \
        { read -rp "New name: " new_name </dev/tty; echo "$new_name"; })
    new_name=$(echo "$new_name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
    CLACK_RESULT="{\"name\":\"${name}\",\"field\":\"name\",\"value\":\"${new_name}\"}"
    cmd_edit_apply
}

cmd_edit_apply() {
    local name field value
    name=$(echo  "$CLACK_RESULT" | jq -r '.name')
    field=$(echo "$CLACK_RESULT" | jq -r '.field')
    value=$(echo "$CLACK_RESULT" | jq -r '.value')
    local old_path; old_path=$(get_project_field "$name" "path")
    local new_path; new_path="$(dirname "$old_path")/${value}"
    mv "$old_path" "$new_path"
    local old_repo; old_repo=$(get_project_field "$name" "repo_url")
    local new_repo="local-only"
    [ "$old_repo" != "local-only" ] && new_repo=$(github_rename_repo "$name" "$value")
    update_project_field "$name"  "name"     "$value"
    update_project_field "$value" "path"     "$new_path"
    [ "$new_repo" != "local-only" ] && update_project_field "$value" "repo_url" "$new_repo"
    log_ok "Renamed: ${name} → ${value}"
}

cmd_visibility() {
    local name; name=$(_pick_active "Toggle visibility:")
    local vis; vis=$(printf 'public\nprivate\n' | _pick_fzf "Set visibility:")
    github_set_visibility "$name" "$vis"
    update_project_field "$name" "visibility" "$vis"
}

cmd_desc() {
    local name; name=$(_pick_active "Set description:")
    local desc; read -rp "Description: " desc </dev/tty
    github_set_description "$name" "$desc"
    update_project_field "$name" "description" "$desc"
}

cmd_complete() {
    local name; name=$(_pick_active "Mark complete:")
    mark_project_complete "$name"
    update_readme_on_complete "$(get_project_field "$name" "path")"
    obsidian_complete "$name" &
    log_done "Completed: ${name}"
}

cmd_archive() {
    local name; name=$(_pick_active "Archive:")
    archive_project "$name"; log_ok "Archived: ${name}"
}

cmd_note() {
    local name; name=$(_pick_active "Note on:")
    local note; read -rp "Note: " note </dev/tty
    obsidian_quick_note "$name" "$note"
    obsidian_daily_log "${name}: ${note}"
    log_ok "Note saved."
}

cmd_open_github() {
    local name; name=$(_pick_active "Open GitHub:")
    local repo; repo=$(get_project_field "$name" "repo_url")
    [ "$repo" = "local-only" ] && log_warn "No GitHub repo." && exit 0
    browser_open_url "$repo"; log_ok "Opened: ${repo}"
}

cmd_open_live() {
    local name; name=$(_pick_active "Open live site:")
    local url; url=$(get_project_field "$name" "netlify_url")
    [ "$url" = "not-deployed" ] && log_warn "Not deployed yet." && exit 0
    browser_open_url "$url"; log_ok "Opened: ${url}"
}

cmd_open_netlify() {
    local name; name=$(_pick_active "Open Netlify dashboard:")
    browser_open_url "https://app.netlify.com/sites/${name}"
    log_ok "Opened Netlify dashboard."
}

cmd_open_folder() {
    local name; name=$(_pick_active "Open folder:")
    local path; path=$(get_project_field "$name" "path")
    xdg-open "$path" &>/dev/null &
    log_ok "Opened: ${path}"
}

cmd_stats() {
    print_banner
    local active complete archived total
    active=$(count_by_status "active")
    complete=$(count_by_status "completed")
    archived=$(count_by_status "archived")
    total=$(( active + complete + archived ))
    echo ""
    log_info "Total:     ${BOLD}${total}${RESET}"
    log_info "Active:    ${active}"
    log_info "Complete:  ${complete}"
    log_info "Archived:  ${archived}"
    echo ""
}

cmd_backup() {
    local dest="$HOME/.gocode-backup/$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$dest"
    cp "$PROJECTS_REGISTRY" "$dest/projects.json"
    cp "$CONFIG_FILE"        "$dest/config.sh"
    log_ok "Backup → ${dest}"
}

cmd_doctor() {
    print_banner
    log_step "Running diagnostics..."
    echo ""
    for dep in git gh jq fzf node netlify code; do
        command -v "$dep" &>/dev/null \
            && log_ok  "${dep}" \
            || log_warn "${dep} — not found"
    done
    echo ""
    jq '.' "$PROJECTS_REGISTRY" &>/dev/null \
        && log_ok "projects.json — valid" \
        || log_error "projects.json — invalid JSON"
    echo ""
    while IFS= read -r n; do
        local p2; p2=$(get_project_field "$n" "path")
        [ -d "$p2" ] \
            && log_ok   "  ${n}" \
            || log_error "  ${n} — folder MISSING: ${p2}"
    done < <(get_incomplete_projects)
    echo ""
    log_done "Doctor complete."
}

cmd_update() {
    log_step "Updating gocode..."
    cd "$GOCODE_DIR" && git pull --rebase
    log_done "gocode updated."
}

# =============================================================================
# HELP
# =============================================================================

