# =============================================================================
# MAIN MENU FUNCTION
# =============================================================================

show_main_menu() {
    clack_run "menu"
    local action
    action=$(echo "$CLACK_RESULT" | jq -r '.action')
    case "$action" in
        new)         create_project ;;
        resume)      resume_project ;;
        push)        cmd_push ;;
        deploy)      cmd_deploy ;;
        list)        cmd_list ;;
        status)      cmd_status ;;
        edit)        cmd_edit ;;
        delete)      cmd_delete ;;
        note)        cmd_note ;;
        config)      run_config_wizard ;;
        set-browser) set_browser_interactive ;;
        doctor)      cmd_doctor ;;
        backup)      cmd_backup ;;
        stats)       cmd_stats ;;
        update)      cmd_update ;;
    esac
}

# =============================================================================
# ROUTER
# =============================================================================

case "${1:-}" in
    --new)          create_project ;;
    --push)         cmd_push ;;
    --deploy)       cmd_deploy ;;
    --status)       cmd_status ;;
    --list)         cmd_list ;;
    --log)          cmd_log ;;
    --diff)         cmd_diff ;;
    --rename)       cmd_rename ;;
    --edit)         cmd_edit ;;
    --delete)       cmd_delete ;;
    --visibility)   cmd_visibility ;;
    --desc)         cmd_desc ;;
    --complete)     cmd_complete ;;
    --archive)      cmd_archive ;;
    --note)         cmd_note ;;
    --open-github)  cmd_open_github ;;
    --open-netlify) cmd_open_netlify ;;
    --open-live)    cmd_open_live ;;
    --open-folder)  cmd_open_folder ;;
    --stats)        cmd_stats ;;
    --backup)       cmd_backup ;;
    --doctor)       cmd_doctor ;;
    --set-browser)  set_browser_interactive ;;
    --config)       run_config_wizard ;;
    --update)       cmd_update ;;
    --help|-h)      show_help ;;
    "")             show_main_menu ;;
    *)  log_error "Unknown command: ${1}"; show_help; exit 1 ;;
esac
