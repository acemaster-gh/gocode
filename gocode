#!/usr/bin/env bash
# =============================================================================
# gocode — Personal Developer Workflow System
# Version: 1.0.2
# Location: ~/.gocode/gocode
# =============================================================================

GOCODE_DIR="$HOME/.gocode"
LIB_DIR="$GOCODE_DIR/lib"
BOILERPLATES_DIR="$GOCODE_DIR/boilerplates"
PLUGINS_DIR="$GOCODE_DIR/plugins"

# ── Source all lib files ──────────────────────────────────────────────────────
source "$LIB_DIR/ui.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/deps.sh"
source "$LIB_DIR/registry.sh"
source "$LIB_DIR/git.sh"
source "$LIB_DIR/browser.sh"
source "$LIB_DIR/netlify.sh"
source "$LIB_DIR/obsidian.sh"
source "$LIB_DIR/colors.sh"
source "$LIB_DIR/readme_gen.sh"

# ── Auto-load plugins ─────────────────────────────────────────────────────────
if [ -d "$PLUGINS_DIR" ]; then
    for plugin in "$PLUGINS_DIR"/*.sh; do
        [ -f "$plugin" ] && source "$plugin"
    done
fi

# =============================================================================
# BOILERPLATE INJECTION
# =============================================================================

inject_boilerplate() {
    local project_name="$1"
    local project_type="$2"
    local template_dir="$BOILERPLATES_DIR/$project_type"

    if [ ! -d "$template_dir" ]; then
        log_warn "No boilerplate found for: $project_type — using vanilla."
        template_dir="$BOILERPLATES_DIR/vanilla"
    fi

    # Copy template files — exclude .sh scripts
    for f in "$template_dir"/*.html "$template_dir"/*.css "$template_dir"/*.js; do
        [ -f "$f" ] && cp "$f" .
    done

    # Replace PROJECT_NAME placeholder
    for file in index.html style.css script.js; do
        [ -f "$file" ] && sed -i "s/PROJECT_NAME/$project_name/g" "$file"
    done

    # Generate and inject random color palette
    generate_palette
    inject_palette "style.css"

    log_ok "Boilerplate injected: $project_type"
}

# =============================================================================
# PROJECT CREATION
# =============================================================================

create_project() {
    divider
    log_step "New Project Setup"
    divider

    # ── Project name ──────────────────────────────────────────────────────────
    local project_name=""
    while true; do
        read -rp "$(echo -e "${YELLOW}[?]${RESET} Project name (e.g. tip-calculator): ")" project_name
        project_name=$(echo "$project_name" \
            | tr '[:upper:]' '[:lower:]' \
            | tr ' ' '-' \
            | tr -cd 'a-z0-9-')

        if [ -z "$project_name" ]; then
            log_error "Name cannot be empty."; continue
        fi
        if [ -d "$PROJECTS_DIR/$project_name" ]; then
            log_error "Folder '$project_name' already exists."; continue
        fi
        if project_exists "$project_name"; then
            log_error "Project '$project_name' already in registry."; continue
        fi
        break
    done

    # ── Project type — arrow key selection ───────────────────────────────────
    local project_type
    project_type=$(select_project_type)

    # ── React scaffold ────────────────────────────────────────────────────────
    if [ "$project_type" = "react" ]; then
        local project_path="$PROJECTS_DIR/$project_name"
        source "$BOILERPLATES_DIR/react/scaffold.sh"
        scaffold_react "$project_name" "$project_path"
        if [ $? -ne 0 ]; then
            log_error "React scaffold failed. Falling back to vanilla."
            project_type="vanilla"
        else
            # Git + GitHub + Netlify for React
            cd "$project_path" || exit 1
            git_init_and_commit
            local repo_url
            repo_url=$(github_create_repo "$project_name")
            netlify_deploy "$project_name" "$project_path" "$repo_url"
            local netlify_url="${NETLIFY_URL:-not-deployed}"
            generate_project_readme "$project_name" "$project_type" "$repo_url" "$netlify_url"
            git_push_final "$repo_url"
            add_project_to_registry "$project_name" "$project_path" "$project_type" "$repo_url" "$netlify_url"
            obsidian_daily_log "$project_name" "$repo_url" "$netlify_url"
            obsidian_project_note "$project_name" "$repo_url" "$netlify_url" "$project_type"
            print_summary_box "$project_name" "$project_type" "$project_path" "$repo_url" "$netlify_url"
            log_step "Opening VS Code..."
            code "$project_path"
            browser_open_tabs &
            return 0
        fi
    fi

    # ── GitHub similar projects search ────────────────────────────────────────
    github_search_similar "$project_name"

    # ── Create folder ─────────────────────────────────────────────────────────
    local project_path="$PROJECTS_DIR/$project_name"
    mkdir -p "$project_path"
    cd "$project_path" || exit 1

    # ── Inject boilerplate + random palette ───────────────────────────────────
    log_step "Creating project files..."
    inject_boilerplate "$project_name" "$project_type"

    # ── Git init + commit ─────────────────────────────────────────────────────
    git_init_and_commit

    # ── GitHub repo ───────────────────────────────────────────────────────────
    local repo_url
    repo_url=$(github_create_repo "$project_name")

    # ── Netlify deploy + verified link ────────────────────────────────────────
    netlify_deploy "$project_name" "$project_path" "$repo_url"
    local netlify_url="${NETLIFY_URL:-not-deployed}"

    # ── Generate README ───────────────────────────────────────────────────────
    generate_project_readme "$project_name" "$project_type" "$repo_url" "$netlify_url"
    git_push_final "$repo_url"

    # ── Save to registry ──────────────────────────────────────────────────────
    add_project_to_registry \
        "$project_name" "$project_path" "$project_type" "$repo_url" "$netlify_url"

    # ── Obsidian notes ────────────────────────────────────────────────────────
    log_step "Writing Obsidian notes..."
    obsidian_daily_log "$project_name" "$repo_url" "$netlify_url"
    obsidian_project_note "$project_name" "$repo_url" "$netlify_url" "$project_type"

    # ── Summary box ───────────────────────────────────────────────────────────
    print_summary_box "$project_name" "$project_type" "$project_path" "$repo_url" "$netlify_url"

    # ── Open VS Code + browser ────────────────────────────────────────────────
    log_step "Opening VS Code..."
    code "$project_path"
    browser_open_tabs &
}

# =============================================================================
# RESUME PROJECT
# =============================================================================

resume_project() {
    local project_name="$1"
    local project_path
    project_path=$(get_project_field "$project_name" "path")

    if [ ! -d "$project_path" ]; then
        log_error "Project folder not found: $project_path"
        return 1
    fi

    log_step "Resuming: $project_name"
    update_last_opened "$project_name"

    local repo_url netlify_url
    repo_url=$(get_project_field "$project_name" "repo_url")
    netlify_url=$(get_project_field "$project_name" "netlify_url")

    obsidian_daily_log "$project_name" "$repo_url" "$netlify_url"

    log_step "Opening VS Code..."
    code "$project_path"
    browser_open_tabs &

    divider
    log_done "Resumed: $project_name"
    echo -e "  ${GREEN}Repo:${RESET}    $repo_url"
    echo -e "  ${GREEN}Netlify:${RESET} $netlify_url"
    divider
}

# =============================================================================
# DELETE PROJECT
# =============================================================================

delete_project() {
    local active=()
    local completed=()
    local all_names=()

    while IFS= read -r name; do
        active+=("$name (active)")
        all_names+=("$name")
    done < <(jq -r '.projects[] | select(.status == "active") | .name' "$PROJECTS_REGISTRY" 2>/dev/null)

    while IFS= read -r name; do
        completed+=("$name (completed)")
        all_names+=("$name")
    done < <(jq -r '.projects[] | select(.status == "completed") | .name' "$PROJECTS_REGISTRY" 2>/dev/null)

    if [ ${#all_names[@]} -eq 0 ]; then
        log_info "No projects to delete."
        return
    fi

    local selected
    selected=$(printf '%s\n' "${active[@]}" "${completed[@]}" \
        | _fzf_pick "Delete project:" 12 "⚠ Deletes folder, GitHub repo, and registry" "prompt:red,pointer:red")

    [ -z "$selected" ] && return

    # Strip status suffix
    local project_name
    project_name=$(echo "$selected" | sed 's/ (active)//;s/ (completed)//')

    local project_path repo_url
    project_path=$(get_project_field "$project_name" "path")
    repo_url=$(get_project_field "$project_name" "repo_url")

    divider
    log_warn "About to delete: $project_name"
    echo -e "  ${DIM}Folder:  $project_path${RESET}"
    echo -e "  ${DIM}Repo:    $repo_url${RESET}"
    divider

    if ! confirm "Are you sure? This cannot be undone."; then
        log_info "Cancelled."
        return
    fi

    # Delete local folder
    if [ -d "$project_path" ]; then
        rm -rf "$project_path"
        log_ok "Local folder deleted."
    fi

    # Delete GitHub repo
    if [[ "$repo_url" != "local-only" && -n "$repo_url" ]]; then
        spinner_start "Deleting GitHub repo..."
        gh repo delete "$project_name" --yes &>/dev/null
        spinner_stop
        log_ok "GitHub repo deleted."
    fi

    # Remove from registry
    local updated
    updated=$(jq --arg name "$project_name" \
        '.projects = [.projects[] | select(.name != $name)]' \
        "$PROJECTS_REGISTRY")
    echo "$updated" > "$PROJECTS_REGISTRY"
    log_ok "Removed from registry."

    log_done "Project '$project_name' deleted."
}

# =============================================================================
# MENUS
# =============================================================================

show_resume_menu() {
    local active_projects=()
    while IFS= read -r name; do
        active_projects+=("$name")
    done < <(get_incomplete_projects)

    [ ${#active_projects[@]} -eq 0 ] && return 1

    # Build display list with metadata
    local display_items=()
    for proj in "${active_projects[@]}"; do
        local last type
        last=$(get_project_field "$proj" "last_opened")
        type=$(get_project_field "$proj" "type")
        display_items+=("$proj  [$type]  last opened: $last")
    done

    display_items+=("── New project")
    display_items+=("── Mark project complete")
    display_items+=("── Delete a project")
    display_items+=("── Status dashboard")

    local selected
    selected=$(printf '%s\n' "${display_items[@]}" \
        | _fzf_pick "Select:" 15 "gocode v1.0.2 — Active Projects")

    [ -z "$selected" ] && exit 0

    case "$selected" in
        "── New project")              return 2 ;;
        "── Mark project complete")    show_complete_menu; main_menu ;;
        "── Delete a project")         delete_project; main_menu ;;
        "── Status dashboard")         show_status; exit 0 ;;
        *)
            local project_name
            project_name=$(echo "$selected" | awk '{print $1}')
            resume_project "$project_name"
            exit 0
            ;;
    esac
}

show_complete_menu() {
    local active_projects=()
    while IFS= read -r name; do
        active_projects+=("$name")
    done < <(get_incomplete_projects)

    [ ${#active_projects[@]} -eq 0 ] && { log_info "No active projects."; return; }

    local selected
    selected=$(printf '%s\n' "${active_projects[@]}" \
        | _fzf_pick "Mark complete:" 10 "" "prompt:green,pointer:green")

    [ -z "$selected" ] && return

    mark_project_complete "$selected"
    obsidian_complete "$selected"

    local project_path
    project_path=$(get_project_field "$selected" "path")
    update_readme_on_complete "$project_path"
}

show_status() {
    print_banner
    divider
    echo -e "  ${BOLD}PROJECT DASHBOARD${RESET}"
    divider

    local total active completed
    total=$(jq '.projects | length' "$PROJECTS_REGISTRY")
    active=$(count_by_status "active")
    completed=$(count_by_status "completed")

    echo -e "  Total: ${BOLD}$total${RESET}  Active: ${GREEN}$active${RESET}  Completed: ${DIM}$completed${RESET}"
    echo ""

    if [ "$active" -gt 0 ]; then
        echo -e "  ${GREEN}${BOLD}ACTIVE${RESET}"
        jq -r '.projects[] | select(.status == "active") |
            "  ▸ \(.name) [\(.type // "vanilla")] — \(.created)\n    \(.repo_url)"' \
            "$PROJECTS_REGISTRY"
        echo ""
    fi

    if [ "$completed" -gt 0 ]; then
        echo -e "  ${DIM}${BOLD}COMPLETED${RESET}"
        jq -r '.projects[] | select(.status == "completed") |
            "  ✓ \(.name) — \(.created)"' \
            "$PROJECTS_REGISTRY" | while IFS= read -r line; do
            echo -e "  ${DIM}$line${RESET}"
        done
        echo ""
    fi

    divider

    local daily_note="$OBSIDIAN_VAULT/05-DAILY-NOTES/$(date +%Y-%m-%d).md"
    if [ -f "$daily_note" ]; then
        log_step "Opening Obsidian..."
        xdg-open "$daily_note" &>/dev/null &
    fi
}

# =============================================================================
# MAIN MENU
# =============================================================================

main_menu() {
    local has_active
    has_active=$(count_by_status "active")

    if [ "$has_active" -gt 0 ]; then
        show_resume_menu
        local result=$?
        [ "$result" -eq 2 ] && create_project
    else
        log_info "No active projects."
        echo ""
        create_project
    fi
}

# =============================================================================
# ENTRYPOINT
# =============================================================================

case "${1:-}" in
    --status|-s)
        load_config; init_registry; show_status ;;
    --complete|-c)
        load_config; init_registry; show_complete_menu ;;
    --delete|-d)
        load_config; init_registry; delete_project ;;
    --push|-p)
        load_config; init_registry; git_push_workflow ;;
    --open|-o)
        load_config; init_registry
        last=$(get_last_active_project)
        if [ -n "$last" ] && [ "$last" != "null" ]; then
            resume_project "$last"
        else
            log_error "No active project found."
        fi ;;
    --deploy)
        load_config; init_registry
        last=$(get_last_active_project)
        project_path=$(get_project_field "$last" "path")
        netlify_redeploy "$project_path" ;;
    --config)
        run_config_wizard ;;
    --update)
        log_step "Pulling latest gocode from GitHub..."
        cd "$GOCODE_DIR" && git pull -q \
            && log_done "gocode updated." \
            || log_error "Update failed." ;;
    --help|-h)
        print_banner
        echo -e "  ${BOLD}Usage:${RESET}"
        echo -e "    gocode               Start or resume a project"
        echo -e "    gocode --push        Commit and push current project"
        echo -e "    gocode --open        Reopen last active project instantly"
        echo -e "    gocode --delete      Delete a project everywhere"
        echo -e "    gocode --deploy      Redeploy last project to Netlify"
        echo -e "    gocode --status      Dashboard + open Obsidian"
        echo -e "    gocode --complete    Mark a project as completed"
        echo -e "    gocode --config      Re-run setup wizard"
        echo -e "    gocode --update      Pull latest version from GitHub"
        echo -e "    gocode --help        Show this help"
        ;;
    "")
        print_banner
        load_config
        check_dependencies
        init_registry
        main_menu ;;
    *)
        log_error "Unknown flag: $1. Run 'gocode --help'."
        exit 1 ;;
esac
